rules_version = '2';

// BM 라운지 보안 규칙 (신청서 방식 · 3판: 학술회 참가자 신분·입학 관심)
// 등록은 구글 폼 응답을 시트 자동 연동(운영진 계정) 또는 운영진 화면 '직접 가져오기'로 합니다.
// 이용자 ID는 '로그인 이메일(소문자)'의 SHA-256 값이라, 같은 이메일로 로그인한 사람만 자기 기록과 연결됩니다.
//  - 프로필(members): 명부에 올라간(approved) 이용자끼리만 볼 수 있음. 등록은 운영진만.
//  - 이메일(contacts): 명부에 올라간 이용자끼리 공개(신청서 '공개 동의')
//      단, 학부생·입학 관심자(학술회 참가자)는 연결 요청이 수락된 상대의 이메일만 봄
//  - 휴대폰·입학 안내 동의(private): 본인과 운영진만
//  - 소개 요청(intros): 보낸 사람과 받은 사람만
//  - 탈퇴 기록(withdrawn): 다시 가져오기 할 때 되살아나지 않게 남기는 표시(이메일·이름 없음)
//  - 운영진 목록(admins): Firebase 콘솔에서만 추가·삭제
// 그 밖의 모든 읽기·쓰기는 기본으로 막힙니다.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 ----------
    function signedIn() { return request.auth != null; }
    function verified() {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.email is string;
    }
    function midOf(email) { return hashing.sha256(email.lower()).toHexString().lower(); }
    function myMid() { return midOf(request.auth.token.email); }
    function isMe(mid) { return verified() && myMid() == mid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function memberPath(mid) { return /databases/$(database)/documents/members/$(mid); }
    function isApprovedMid(mid) { return exists(memberPath(mid)) && get(memberPath(mid)).data.status == 'approved'; }
    function isApproved() { return verified() && isApprovedMid(myMid()); }

    // 선택지 키: public/js/constants.js 와 같아야 합니다.
    function industryList() { return ['food','beauty','retail','agency','service','mfg','public','etc']; }
    function fnList() { return ['mkt','brand','design','cx','content','sales','strat','ceo','fin','ops','edu','etc']; }
    function helpList() { return ['brand','design','perf','content','channel','global','invest','hiring','data','mentor','partner','admit']; }
    function typeList() { return ['grad','student','conf']; }
    function stageList() { return ['work','prof','ugrad','gstu','etc']; }
    function admitList() { return ['yes','applied','no']; }
    function yearsList() { return ['none','y0','y4','y8','y13','y20']; }

    function textOk(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function keysOk(v, allowed) {
      return v is list && v.size() <= 3 && v.toSet().size() == v.size() && v.hasOnly(allowed);
    }
    // 주요 경력: 최대 3줄, 한 줄 60자
    function lineOk(c, i) { return c.size() <= i || textOk(c[i], 1, 60); }
    function careerOk(c) { return c is list && c.size() <= 3 && lineOk(c, 0) && lineOk(c, 1) && lineOk(c, 2); }
    function intOrNull(v, min, max) { return v == null || (v is int && v >= min && v <= max); }
    // 학부생·입학 관심자인 학술회 참가자: 다른 이용자 이메일은 연결이 수락된 뒤에만
    function limitedData(d) {
      return d.type == 'conf' && (d.get('stage', null) == 'ugrad' || d.get('admit', null) in ['yes','applied']);
    }
    // stage·admit(학술회 참가자의 신분·입학 관심)은 3판에서 추가. 예전 기록에는 없을 수 있음
    function optIn(d, k, list) { return d.get(k, null) == null || d.get(k, null) in list; }
    // thesis(학위논문 제목)는 더 받지 않음. 예전 기록에 남아 있을 수 있어 있으면 허용만(새로 쓰는 화면·연동은 넣지 않음)
    function profileOk(d) {
      return d.keys().hasOnly(['name','type','stage','admit','year','cohort','thesis','org','title','industry','fn','fnEtc','years','career','offer','offerEtc','need','needEtc','intro','status','createdAt','updatedAt'])
        && d.keys().hasAll(['name','type','year','cohort','org','title','industry','fn','fnEtc','years','career','offer','offerEtc','need','needEtc','intro','status','createdAt','updatedAt'])
        && textOk(d.name, 1, 20)
        && d.type in typeList()
        && optIn(d, 'stage', stageList())
        && optIn(d, 'admit', admitList())
        && intOrNull(d.year, 1995, 2030)
        && intOrNull(d.cohort, 1, 99)
        && textOk(d.get('thesis', ''), 0, 100)
        && textOk(d.org, 1, 40)
        && textOk(d.title, 1, 40)
        && d.industry in industryList()
        && keysOk(d.fn, fnList()) && textOk(d.fnEtc, 0, 60)
        && d.years in yearsList()
        && careerOk(d.career)
        && keysOk(d.offer, helpList()) && textOk(d.offerEtc, 0, 60)
        && keysOk(d.need, helpList()) && textOk(d.needEtc, 0, 60)
        && textOk(d.intro, 0, 60)
        && d.status in ['approved','hidden'];
    }

    // ---------- 동문 프로필 ----------
    match /members/{mid} {
      allow get: if isAdmin() || isMe(mid) || (isApproved() && resource.data.status == 'approved');
      allow list: if isAdmin() || (isApproved() && resource.data.status == 'approved');

      // 등록: 운영진만 (신청서 가져오기)
      allow create: if isAdmin()
        && profileOk(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if
        // 본인: 프로필만 고칠 수 있고 명부 상태와 등록일은 못 바꿈.
        // 학부생·입학 관심자는 스스로 그 표시를 풀 수 없음(구분·신분·입학 관심 변경은 운영진이 신청서로)
        (isMe(mid)
          && profileOk(request.resource.data)
          && (!limitedData(resource.data) || limitedData(request.resource.data))
          && request.resource.data.status == resource.data.status
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time)
        // 운영진: 명부 상태 변경, 신청서 내용으로 덮어쓰기
        || (isAdmin()
          && profileOk(request.resource.data)
          && request.resource.data.updatedAt == request.time);

      allow delete: if isMe(mid) || isAdmin();
    }

    // ---------- 이메일 ----------
    function contactOk(d, mid) {
      return d.keys().hasOnly(['email','consent'])
        && d.email is string && midOf(d.email) == mid
        && d.consent is map
        && d.consent.keys().hasOnly(['map','privacy','version','at','via'])
        && d.consent.map == true && d.consent.privacy == true
        && textOk(d.consent.version, 1, 20)
        && d.consent.at is timestamp;
    }
    function limited() { return limitedData(get(memberPath(myMid())).data); }
    // 둘 사이 소개 요청이 수락됨(어느 쪽이 보냈든)
    function introPath(id) { return /databases/$(database)/documents/intros/$(id); }
    function acceptedIntro(id) { return exists(introPath(id)) && get(introPath(id)).data.status == 'accepted'; }
    function linked(mid) { return acceptedIntro(myMid() + '_' + mid) || acceptedIntro(mid + '_' + myMid()); }

    match /contacts/{mid} {
      allow get: if isAdmin() || isMe(mid) || (isApproved() && isApprovedMid(mid) && (!limited() || linked(mid)));
      allow list: if isAdmin();
      allow create: if isAdmin() && contactOk(request.resource.data, mid)
        && request.resource.data.consent.at == request.time;
      allow update: if isAdmin() && contactOk(request.resource.data, mid);
      allow delete: if isMe(mid) || isAdmin();
    }

    // ---------- 휴대폰·입학 안내 동의 (운영진과 본인만) ----------
    match /private/{mid} {
      allow get: if isAdmin() || isMe(mid);
      allow list: if isAdmin();
      allow create, update: if (isAdmin() || isMe(mid))
        && request.resource.data.keys().hasOnly(['phone','admitInfo'])
        && textOk(request.resource.data.phone, 0, 20)
        && request.resource.data.get('admitInfo', false) is bool;
      allow delete: if isMe(mid) || isAdmin();
    }

    // ---------- 소개 요청 ----------
    // 문서 ID = 보낸동문ID_받는동문ID
    match /intros/{id} {
      allow get: if isAdmin() || (verified() && (id.split('_')[0] == myMid() || id.split('_')[1] == myMid()));
      allow list: if verified() && (resource.data.from == myMid() || resource.data.to == myMid());

      allow create: if isApproved()
        && request.resource.data.keys().hasOnly(['from','to','fromName','fromCohort','message','status','createdAt'])
        && request.resource.data.from == myMid()
        && request.resource.data.to is string
        && request.resource.data.to != myMid()
        && id == myMid() + '_' + request.resource.data.to
        && isApprovedMid(request.resource.data.to)
        && request.resource.data.fromName == get(memberPath(myMid())).data.name
        && request.resource.data.fromCohort == get(memberPath(myMid())).data.cohort
        && textOk(request.resource.data.message, 1, 500)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // 받은 사람만 수락·거절
      allow update: if verified() && resource.data.to == myMid()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
        && request.resource.data.status in ['accepted','declined']
        && request.resource.data.respondedAt == request.time;

      allow delete: if verified() && (resource.data.from == myMid() || resource.data.to == myMid());
    }

    // ---------- 탈퇴 기록 ----------
    match /withdrawn/{mid} {
      allow create, update: if isMe(mid)
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
      allow get, list, delete: if isAdmin();
    }

    // ---------- 운영진 목록 ----------
    // 문서 ID = 운영진 로그인 계정의 UID. 추가와 삭제는 Firebase 콘솔에서만.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }
  }
}
